<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2: wallet name, today's spending, big balance and four buttons (+1k −100 −50 −20). -->
<!-- targetCell* (Android 12+) and widgetFeatures (Android 9+) are ignored on older phones, which use minWidth/minHeight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:configure="com.patternsystems.pocketcash.widget.WidgetConfigActivity"
    android:description="@string/widget_medium_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewImage="@drawable/ic_launcher_fg"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional"
    tools:ignore="UnusedAttribute" />
