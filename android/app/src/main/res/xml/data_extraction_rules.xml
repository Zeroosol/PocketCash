<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: the wallet file goes into Google's device backup and phone-to-phone transfers.
     CSV exports are temporary files in the cache and are never backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="pocketcash.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="pocketcash.json" />
    </device-transfer>
</data-extraction-rules>
