# Xcode and SwiftPM build output (XcodeGen recreates the .xcodeproj and the Config/*.plist files from project.yml)
*.xcodeproj
xcuserdata/
DerivedData/
.build/
.bsp/
.swiftpm/
.DS_Store
ios/Config/

# xtool: the built app and signed .ipa carry your provisioning profile; the model expansion is regenerated by
# `node tools/xtool_prepare.js`.
ios/xtool/.xtool-tmp/
ios/xtool/*.app/
ios/xtool/*.ipa
ios/xtool/manifest.plist
ios/Shared/Models+xtool.swift

# Android: Gradle and Android Studio output. local.properties holds your SDK path.
android/.gradle/
android/.kotlin/
android/**/build/
android/local.properties
android/.idea/
android/captures/
*.iml

# Keys and certificates must never be committed
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*.cer
*.pem
.env
.env.*

# Personal Claude Code settings
.claude/settings.local.json
